@page "/integration"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http

<PageTitle>Data Integration</PageTitle>

<h1>Data Integration</h1>

<p class="lead">
    Upload sales data, monitor integration jobs, and review validation errors.
</p>

<div class="card shadow-sm mb-4">
    <div class="card-body">

        <h4>Upload Sales CSV</h4>

        <p class="text-muted">
            Select a CSV file containing sales transaction data.
        </p>

        <InputFile OnChange="HandleFileSelected"
                   accept=".csv,text/csv"
                   class="form-control mb-3" />

        @if (selectedFile != null)
        {
            <div class="mb-3">
                <strong>Selected:</strong> @selectedFile.Name
                <br />
                <small class="text-muted">
                    @((selectedFile.Size / 1024.0).ToString("0.0")) KB
                </small>
            </div>
        }

        <button class="btn btn-primary"
                @onclick="UploadFile"
                disabled="@(selectedFile == null || uploading)">
            @if (uploading)
            {
                <span>Uploading...</span>
            }
            else
            {
                <span>Upload & Process</span>
            }
        </button>

        @if (!string.IsNullOrWhiteSpace(uploadMessage))
        {
            <div class="alert @uploadAlertClass mt-3">
                @uploadMessage
            </div>
        }

    </div>
</div>

@if (loading)
{
    <p>Loading integration data...</p>
}
else if (error != null)
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6>Total Jobs</h6>
                    <h2>@jobs.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6>Successful Records</h6>
                    <h2>@jobs.Sum(x => x.SuccessfulRecords)</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6>Validation Errors</h6>
                    <h2>@validationErrors.Count</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4>Integration Jobs</h4>

            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Job ID</th>
                            <th>Source</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th>Successful</th>
                            <th>Failed</th>
                            <th>Started</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var job in jobs)
                        {
                            <tr>
                                <td>@job.Id</td>
                                <td>@job.SourceSystem</td>

                                <td>
                                    @if (job.Status == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            @job.Status
                                        </span>
                                    }
                                    else if (job.Status == "CompletedWithErrors")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @job.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @job.Status
                                        </span>
                                    }
                                </td>

                                <td>@job.TotalRecords</td>
                                <td>@job.SuccessfulRecords</td>
                                <td>@job.FailedRecords</td>
                                <td>@job.StartedAt.ToLocalTime().ToString("MM/dd/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <h4>Validation Errors</h4>

            @if (validationErrors.Count == 0)
            {
                <div class="alert alert-success">
                    No validation errors found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Job</th>
                                <th>Record</th>
                                <th>Field</th>
                                <th>Error</th>
                                <th>Created</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in validationErrors)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.IntegrationJobId</td>
                                    <td>@item.RecordIdentifier</td>
                                    <td>@item.FieldName</td>
                                    <td>@item.ErrorMessage</td>
                                    <td>@item.CreatedAt.ToLocalTime().ToString("MM/dd/yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
}

@code {
    private List<IntegrationJobModel> jobs = [];
    private List<ValidationErrorModel> validationErrors = [];

    private IBrowserFile? selectedFile;

    private bool loading = true;
    private bool uploading;

    private string? error;
    private string? uploadMessage;

    private string uploadAlertClass = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        uploadMessage = null;
    }

    private async Task UploadFile()
    {
        if (selectedFile == null)
            return;

        uploading = true;
        uploadMessage = null;

        try
        {
            using var content = new MultipartFormDataContent();

            const long maxFileSize = 10 * 1024 * 1024;

            await using var stream =
                selectedFile.OpenReadStream(maxFileSize);

            using var fileContent =
                new StreamContent(stream);

            fileContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(
                    "text/csv");

            content.Add(
                fileContent,
                "file",
                selectedFile.Name);

            var response = await Http.PostAsync(
                "api/integration/import-sales-csv",
                content);

            if (response.IsSuccessStatusCode)
            {
                var result =
                    await response.Content.ReadFromJsonAsync<ImportResult>();

                uploadAlertClass = "alert-success";

                uploadMessage =
                    $"Import completed. Job {result?.JobId}: " +
                    $"{result?.SuccessfulRecords} successful, " +
                    $"{result?.FailedRecords} failed.";

                selectedFile = null;

                await LoadData();
            }
            else
            {
                var responseText =
                    await response.Content.ReadAsStringAsync();

                uploadAlertClass = "alert-danger";

                uploadMessage =
                    $"Upload failed: {responseText}";
            }
        }
        catch (Exception ex)
        {
            uploadAlertClass = "alert-danger";
            uploadMessage = $"Upload failed: {ex.Message}";
        }
        finally
        {
            uploading = false;
        }
    }

    private async Task LoadData()
    {
        try
        {
            error = null;

            jobs =
                await Http.GetFromJsonAsync<List<IntegrationJobModel>>(
                    "api/integration/jobs") ?? [];

            validationErrors =
                await Http.GetFromJsonAsync<List<ValidationErrorModel>>(
                    "api/integration/errors") ?? [];
        }
        catch (Exception ex)
        {
            error = $"Unable to load integration data: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private class ImportResult
    {
        public int JobId { get; set; }
        public string Status { get; set; } = "";
        public int TotalRecords { get; set; }
        public int SuccessfulRecords { get; set; }
        public int FailedRecords { get; set; }
    }

    private class IntegrationJobModel
    {
        public int Id { get; set; }
        public string SourceSystem { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime StartedAt { get; set; }
        public DateTime? CompletedAt { get; set; }
        public int TotalRecords { get; set; }
        public int SuccessfulRecords { get; set; }
        public int FailedRecords { get; set; }
    }

    private class ValidationErrorModel
    {
        public int Id { get; set; }
        public int IntegrationJobId { get; set; }
        public string RecordIdentifier { get; set; } = "";
        public string FieldName { get; set; } = "";
        public string ErrorMessage { get; set; } = "";
        public DateTime CreatedAt { get; set; }
    }
}
