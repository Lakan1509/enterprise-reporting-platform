@page "/"
@using System.Net.Http.Json
@using EnterpriseReporting.Web.Models
@using EnterpriseReporting.Web.Services
@inject ReportingApiService Api
@inject HttpClient Http

<PageTitle>Enterprise Reporting Dashboard</PageTitle>

<style>
    .metric-card {
        border: 0;
        border-radius: 14px;
    }

    .metric-value {
        font-size: 2rem;
        font-weight: 700;
    }

    .chart-row {
        margin-bottom: 18px;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .chart-track {
        width: 100%;
        height: 22px;
        background: #e9ecef;
        border-radius: 8px;
        overflow: hidden;
    }

    .chart-bar {
        height: 100%;
        background: #0d6efd;
        border-radius: 8px;
        min-width: 4px;
    }

    .import-chart-bar {
        height: 100%;
        background: #198754;
        border-radius: 8px;
        min-width: 4px;
    }
</style>

<h1>Enterprise Reporting Dashboard</h1>

<p class="lead">
    Enterprise analytics, operational reporting, and data integration overview.
</p>

@if (loading)
{
    <p>Loading dashboard...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">
        @error
    </div>
}
else
{
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm h-100 metric-card">
                <div class="card-body">
                    <small class="text-muted">Total Revenue</small>

                    <div class="metric-value mt-2">
                        @summary!.TotalRevenue.ToString("C")
                    </div>

                    <span class="badge bg-success">
                        @summary.CompletedOrders completed
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100 metric-card">
                <div class="card-body">
                    <small class="text-muted">Total Orders</small>

                    <div class="metric-value mt-2">
                        @summary!.TotalOrders
                    </div>

                    <span class="text-muted">
                        @summary.PendingOrders pending
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100 metric-card">
                <div class="card-body">
                    <small class="text-muted">Customers</small>

                    <div class="metric-value mt-2">
                        @summary!.TotalCustomers
                    </div>

                    <span class="text-muted">
                        Enterprise accounts
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100 metric-card">
                <div class="card-body">
                    <small class="text-muted">Products</small>

                    <div class="metric-value mt-2">
                        @summary!.TotalProducts
                    </div>

                    <span class="text-muted">
                        Product catalog
                    </span>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100 metric-card">
                <div class="card-body">
                    <small class="text-muted">Imported Sales</small>

                    <h3 class="mt-2">
                        @imported!.TotalImportedSales.ToString("C")
                    </h3>

                    <span class="text-muted">
                        @imported.TotalImportedTransactions transactions
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 metric-card">
                <div class="card-body">
                    <small class="text-muted">Average Order Value</small>

                    <h3 class="mt-2">
                        @summary!.AverageOrderValue.ToString("C")
                    </h3>

                    <span class="text-muted">
                        Across all orders
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 metric-card">
                <div class="card-body">
                    <small class="text-muted">Integration Health</small>

                    @if (integrationErrors == 0)
                    {
                        <h3 class="text-success mt-2">
                            Healthy
                        </h3>
                    }
                    else
                    {
                        <h3 class="text-warning mt-2">
                            @integrationErrors issues
                        </h3>
                    }

                    <span class="text-muted">
                        @integrationJobs jobs processed
                    </span>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-lg-6">
            <div class="card shadow-sm h-100 metric-card">
                <div class="card-body">

                    <h4 class="mb-4">
                        Order Revenue by Region
                    </h4>

                    @if (salesByRegion.Count == 0)
                    {
                        <p class="text-muted">No order data available.</p>
                    }
                    else
                    {
                        @foreach (var region in salesByRegion)
                        {
                            <div class="chart-row">

                                <div class="chart-header">
                                    <strong>@region.Region</strong>

                                    <span>
                                        @region.Revenue.ToString("C")
                                        · @region.OrderCount orders
                                    </span>
                                </div>

                                <div class="chart-track">
                                    <div class="chart-bar"
                                         style="width:@GetOrderBarWidth(region.Revenue)%">
                                    </div>
                                </div>

                            </div>
                        }
                    }

                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100 metric-card">
                <div class="card-body">

                    <h4 class="mb-4">
                        Imported Sales by Region
                    </h4>

                    @if (imported!.SalesByRegion.Count == 0)
                    {
                        <p class="text-muted">
                            No imported sales available.
                        </p>
                    }
                    else
                    {
                        @foreach (var region in imported.SalesByRegion)
                        {
                            <div class="chart-row">

                                <div class="chart-header">
                                    <strong>@region.Region</strong>

                                    <span>
                                        @region.Revenue.ToString("C")
                                        · @region.TransactionCount transactions
                                    </span>
                                </div>

                                <div class="chart-track">
                                    <div class="import-chart-bar"
                                         style="width:@GetImportBarWidth(region.Revenue)%">
                                    </div>
                                </div>

                            </div>
                        }
                    }

                </div>
            </div>
        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="card shadow-sm h-100 metric-card">
                <div class="card-body">

                    <h4>Order Status</h4>

                    <div class="row mt-4">

                        <div class="col-6 text-center">
                            <h2 class="text-success">
                                @summary!.CompletedOrders
                            </h2>
                            <div>Completed</div>
                        </div>

                        <div class="col-6 text-center">
                            <h2 class="text-warning">
                                @summary.PendingOrders
                            </h2>
                            <div>Pending</div>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100 metric-card">
                <div class="card-body">

                    <h4>Data Integration</h4>

                    <div class="row mt-4">

                        <div class="col-6 text-center">
                            <h2>@integrationJobs</h2>
                            <div>Jobs</div>
                        </div>

                        <div class="col-6 text-center">
                            <h2 class="text-warning">
                                @integrationErrors
                            </h2>
                            <div>Validation Errors</div>
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm metric-card">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h4 class="mb-0">
                    Recent Orders
                </h4>

                <span class="badge bg-secondary">
                    Latest @recentOrders.Count
                </span>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Customer</th>
                            <th>Region</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var order in recentOrders)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @order.OrderNumber
                                    </strong>
                                </td>

                                <td>@order.CustomerName</td>

                                <td>@order.Region</td>

                                <td>
                                    @order.OrderDate.ToString("MM/dd/yyyy")
                                </td>

                                <td>
                                    @order.TotalAmount.ToString("C")
                                </td>

                                <td>
                                    @if (order.Status == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @order.Status
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>
}

@code {
    private DashboardSummary? summary;
    private ImportedSalesSummary? imported;

    private List<RecentOrder> recentOrders = [];
    private List<RegionOrderSummary> salesByRegion = [];

    private int integrationJobs;
    private int integrationErrors;

    private bool loading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            summary =
                await Api.GetDashboardSummaryAsync();

            imported =
                await Api.GetImportedSalesSummaryAsync();

            recentOrders =
                await Api.GetRecentOrdersAsync();

            salesByRegion =
                await Http.GetFromJsonAsync<List<RegionOrderSummary>>(
                    "api/dashboard/sales-by-region")
                ?? [];

            var jobs =
                await Http.GetFromJsonAsync<List<IntegrationJobSummary>>(
                    "api/integration/jobs")
                ?? [];

            var errors =
                await Http.GetFromJsonAsync<List<ValidationErrorSummary>>(
                    "api/integration/errors")
                ?? [];

            integrationJobs = jobs.Count;
            integrationErrors = errors.Count;
        }
        catch (Exception ex)
        {
            error =
                $"Unable to load dashboard: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private decimal GetOrderBarWidth(decimal revenue)
    {
        if (salesByRegion.Count == 0)
            return 0;

        var maxRevenue =
            salesByRegion.Max(x => x.Revenue);

        if (maxRevenue == 0)
            return 0;

        return Math.Round(
            revenue / maxRevenue * 100,
            2);
    }

    private decimal GetImportBarWidth(decimal revenue)
    {
        if (imported == null ||
            imported.SalesByRegion.Count == 0)
            return 0;

        var maxRevenue =
            imported.SalesByRegion.Max(x => x.Revenue);

        if (maxRevenue == 0)
            return 0;

        return Math.Round(
            revenue / maxRevenue * 100,
            2);
    }

    private class RegionOrderSummary
    {
        public string Region { get; set; } = "";
        public int OrderCount { get; set; }
        public decimal Revenue { get; set; }
    }

    private class IntegrationJobSummary
    {
        public int Id { get; set; }
    }

    private class ValidationErrorSummary
    {
        public int Id { get; set; }
    }
}
